# Variables requeridas, sin valores (PRD 6.5). Copiar a .env y completar.
# La clave del modelo vive SOLO aquí (backend); nunca en el repo, el front, los logs ni la API.

# --- Proveedor LLM ---
ANTHROPIC_API_KEY=
# Valor por defecto: anthropic (único proveedor implementado detrás del adaptador)
LLM_PROVIDER=
# Identificador del modelo del proveedor (defecto: claude-opus-5-5)
LLM_MODEL=
# Timeout por llamada al proveedor, en milisegundos (defecto: 60000)
LLM_TIMEOUT_MS=
# max_tokens por respuesta del modelo (defecto: 16000)
LLM_MAX_TOKENS=
# Esfuerzo del modelo: low | medium | high | xhigh | max (defecto: medium)
LLM_EFFORT=
# Reintentos del SDK ante 408/409/429/5xx/red, 0-5 (defecto: 1). Tiempo máx. por llamada ≈ timeout × (reintentos + 1)
LLM_MAX_REINTENTOS=

# --- Límites de costo ---
# Iteraciones herramienta -> modelo por turno (defecto: 25)
MAX_ITERACIONES=
# Tokens máximos por sesión (defecto: 200000)
MAX_TOKENS_SESION=

# --- Servidor ---
# Puerto HTTP (defecto: 3000)
PORT=

# --- Determinismo ---
# Fecha/hora ISO con offset que congela el reloj (ej. formato 2026-01-31T00:00:00-05:00).
# Vacía = hora real. demo.ts y los tests usan su propia fecha fija y no dependen de esta variable.
FECHA_REFERENCIA=
